---
import BaseLayout from "./BaseLayout.astro";
interface Props {
  title: string;
  summary: string;
  date: Date;
  tags?: string[];
  ogImage?: string;
}
const { title, summary, date, tags = [], ogImage } = Astro.props;
---

<BaseLayout title={title} description={summary} ogImage={ogImage}>
  <article class="prose prose-invert max-w-none prose-pre:bg-[var(--color-panel)]">
    <header class="not-prose mb-8 border-b border-white/10 pb-6">
      <p class="font-mono text-xs text-[var(--color-muted)]">
        <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>
        {tags.length > 0 && <span> · {tags.join(" · ")}</span>}
      </p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight">{title}</h1>
      <p class="mt-2 text-[var(--color-muted)]">{summary}</p>
    </header>
    <slot />
  </article>
</BaseLayout>
