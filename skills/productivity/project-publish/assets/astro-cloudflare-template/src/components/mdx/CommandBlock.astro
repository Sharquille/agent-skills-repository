---
// Sanitized command snippet with a copy button. The `sanitized` flag is a
// reminder that the content was already redacted upstream — this component does
// not redact; the publish gate does.
interface Props {
  code: string;
  language?: "bash" | "powershell" | "ios" | "json" | "yaml";
  title?: string;
  sanitized?: true;
  copy?: boolean;
}
const { code, language = "bash", title, copy = true } = Astro.props;
---

<figure class="not-prose my-5 overflow-hidden rounded-lg border border-white/10 bg-[var(--color-panel)]">
  <figcaption class="flex items-center justify-between border-b border-white/10 px-3 py-1.5 text-xs text-[var(--color-muted)]">
    <span>{title ?? language}</span>
    {copy && (
      <button type="button" data-copy class="rounded border border-white/15 px-2 py-0.5" aria-label="Copy command">copy</button>
    )}
  </figcaption>
  <pre class="overflow-x-auto p-3 text-sm"><code class={`language-${language}`}>{code}</code></pre>
</figure>

{
  copy && (
    <script>
      document.querySelectorAll('[data-copy]').forEach((btn) =>
        btn.addEventListener('click', () => {
          const code = btn.closest('figure')?.querySelector('code')?.textContent ?? '';
          navigator.clipboard.writeText(code);
          const b = btn as HTMLButtonElement;
          b.textContent = 'copied'; setTimeout(() => (b.textContent = 'copy'), 1200);
        }),
      );
    </script>
  )
}
